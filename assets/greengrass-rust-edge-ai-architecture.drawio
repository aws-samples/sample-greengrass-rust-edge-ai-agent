        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=1;spacingLeft=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Edge footprint:&lt;/b&gt; SDK (0.5 MB) + ort (5 MB) + model (12 MB) + binary (5 MB) = ~23 MB&lt;br&gt;&lt;b&gt;Offline-first:&lt;/b&gt; Local inference continues during network outages; escalations queue in ring buffer&lt;br&gt;&lt;b&gt;Cloud agent:&lt;/b&gt; Root cause analysis using Timestream historical data; generates maintenance recommendations" vertex="1">
